%global npm_name @types/js-yaml

Name: nodejs-types-js-yaml
Version: 4.0.9
Release: 1%{?dist}
Summary: TypeScript definitions for js-yaml
License: MIT
URL: https://github.com/DefinitelyTyped/DefinitelyTyped/tree/master/types/js-yaml
Source0: https://registry.npmjs.org/@types/js-yaml/-/js-yaml-%{version}.tgz
BuildRequires: nodejs-packaging
%if 0%{?rhel} == 10
# https://issues.redhat.com/browse/RHEL-137712 is fixed in RHEL 10.3
BuildRequires: /usr/bin/node
%endif
BuildArch: noarch
ExclusiveArch: %{nodejs_arches} noarch
Provides: npm(%{npm_name}) = %{version}

%description
%{summary}

%prep
%setup -q -n js-yaml

%install
mkdir -p %{buildroot}%{nodejs_sitelib}/%{npm_name}
cp -pfr index.d.mts %{buildroot}%{nodejs_sitelib}/%{npm_name}
cp -pfr index.d.ts %{buildroot}%{nodejs_sitelib}/%{npm_name}
cp -pfr package.json %{buildroot}%{nodejs_sitelib}/%{npm_name}


%files
%{nodejs_sitelib}/%{npm_name}
%license LICENSE
%doc README.md

%changelog
* Tue Oct 27 2026 Nadja Heitmann <nadjah@atix.de> 4.0.9-1
- Add nodejs-types-js-yaml generated by npm2rpm using the single strategy

